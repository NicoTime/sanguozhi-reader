      },
      "contextNote": "《汉晋春秋》记对吴关系之议；AI 声音与画面为艺术演绎。",
      "sourceIds": [
        "epub"
      ],
      "attribution": {
        "label": "裴注引《汉晋春秋》记对吴关系之议"
      }
