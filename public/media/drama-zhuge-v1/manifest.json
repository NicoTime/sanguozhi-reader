    {
      "id": "note-p12-note1-64",
      "sceneId": "zhuge-liang-p12",
      "speakerId": "zhuge-liang",
      "title": "答众贺",
      "quote": {
        "target": "note",
        "textOffset": 64,
        "text": "普天之下，莫非汉民，国家威力未举，使百姓困于豺狼之吻。一夫有死，皆亮之罪，以此相贺，能不为愧。",
        "noteId": "zhuge-liang-p12-note1"
      },
      "audio": {
        "path": "media/drama-zhuge-v1/audio/note-p12-note1-64.wav",
